# Store + Admin API
SHOP=nkqtxa-gi.myshopify.com
API_VERSION=2026-01

# Dev-Dashboard app credentials (client-credentials grant).
# The app must have read_orders + write_orders scopes granted.
# The Secret also verifies the webhook HMAC.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Fee settings (Phase 2 will make these editable in a UI)
COD_FEE_AMOUNT=10.00
COD_FEE_CURRENCY=AED
COD_FEE_TITLE=Cash on Delivery fee
COD_FEE_TAXABLE=false
COD_GATEWAY_MATCH=cash on delivery

# Server
PORT=3000
